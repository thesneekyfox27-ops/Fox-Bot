diff -ru a/config/cl_edit.lua b/config/cl_edit.lua
--- a/config/cl_edit.lua	2026-10-01 10:29:12.202083864 +0000
+++ b/config/cl_edit.lua	2026-10-01 10:29:12.215885653 +0000
@@ -115,7 +115,7 @@
 local function keyResource()
     if Config.KeySystem and Config.KeySystem ~= '0r-vehiclekeys' then return Config.KeySystem end
 
-    for _, res in ipairs({ '0r-vehiclekeys', 'qbx_vehiclekeys', 'qs-vehiclekeys',
+    for _, res in ipairs({ 'fox_keyring', '0r-vehiclekeys', 'qbx_vehiclekeys', 'qs-vehiclekeys',
                            'wasabi_carlock', 'MrNewbVehicleKeys', 'Renewed-Vehiclekeys',
                            'mk_vehiclekeys', 'qb-vehiclekeys' }) do
         if GetResourceState(res) == 'started' then return res end
@@ -130,7 +130,10 @@
     local res = keyResource()
     vehicle = vehicle or cache.vehicle
 
-    if res == '0r-vehiclekeys' then
+    if res == 'fox_keyring' then
+        -- The server checks player_vehicles (owner or job) before adding the key.
+        pcall(function() exports.fox_keyring:ClaimKey(plate) end)
+    elseif res == '0r-vehiclekeys' then
         -- NRP: 0r-vehiclekeys exposes GiveKeys(plate) ONLY. The old code tried the
         -- entity signature first (which pcall reports as "success" even though 0r
         -- stringifies the entity id into a junk plate) and then ALSO fired the
@@ -169,7 +172,10 @@
     local res = keyResource()
     vehicle = vehicle or cache.vehicle
 
-    if res == '0r-vehiclekeys' then
+    if res == 'fox_keyring' then
+        -- Keys live on the player's keyring permanently, so storing the car keeps them.
+        return
+    elseif res == '0r-vehiclekeys' then
         -- NRP: plate-only, matching GiveKeys above. Passing the entity here used to
         -- target a junk plate and leave the real key behind in the inventory.
         pcall(function() exports['0r-vehiclekeys']:RemoveKeys(plate) end)
